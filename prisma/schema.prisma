// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. 留言板 (Guestbook)
model Message {
  id        String   @id @default(uuid())
  message   String
  createdAt DateTime @default(now())
  
  userId    String
  userName  String
  userImg   String?

  // 👇 新增：关联 Like 表，让留言可以被点赞
  likes     Like[]
  
}

// 2. 博客评论 (Blog Comments)
model Comment {
  id        String   @id @default(uuid())
  content   String   // 评论内容
  createdAt DateTime @default(now())
  
  // 博客标识 (对应 Sanity/文章文件的 slug)
  blogSlug  String   

  // 评论者信息 (从 Clerk 获取)
  userId    String
  userName  String
  userImg   String?

  // 👇 修改：这里关联的是通用的 Like 表，而不是 CommentLike
  likes     Like[]

  // 👇 新增：父子关系
  parentId  String?  // 如果是顶层评论，这里是 null；如果是回复，这里存父评论 ID
  parent    Comment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies") // 一条评论可以有多个回复
}

// 3. 通用点赞表 (Universal Like System)
// 这张表替代了你之前的 BlogLike 和 CommentLike
model Like {
  id        String   @id @default(uuid())
  userId    String   // 点赞人的 Clerk ID

  // --- 场景 A: 给留言板点赞 ---
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  // --- 场景 B: 给博客文章点赞 ---
  // 文章本身不在数据库里，所以直接存 slug
  blogSlug  String?  

  // --- 场景 C: 给评论点赞 ---
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // --- 唯一性约束 (防止重复点赞) ---
  // 确保同一个用户在同一场景下只能点一次赞
  @@unique([userId, messageId]) // 留言板防刷
  @@unique([userId, blogSlug])  // 文章防刷
  @@unique([userId, commentId]) // 评论防刷
}